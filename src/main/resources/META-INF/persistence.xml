<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd" version="3.2">
 <persistence-unit name="autocare" transaction-type="RESOURCE_LOCAL">
  <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
  <class>hr.unizd.autocare.domain.User</class>
  <class>hr.unizd.autocare.domain.VehicleVariant</class>
  <class>hr.unizd.autocare.domain.Vehicle</class>
  <class>hr.unizd.autocare.domain.WorkDefinition</class>
  <class>hr.unizd.autocare.domain.VehicleWorkRule</class>
  <class>hr.unizd.autocare.domain.ServiceRecord</class>
  <class>hr.unizd.autocare.domain.ServiceItem</class>
  <class>hr.unizd.autocare.domain.Problem</class>
  <class>hr.unizd.autocare.domain.DiagnosticRule</class>

  <exclude-unlisted-classes>true</exclude-unlisted-classes>
  <properties><property name="hibernate.hbm2ddl.auto" value="validate"/><property name="hibernate.show_sql" value="false"/><property name="hibernate.jdbc.time_zone" value="UTC"/></properties>
 </persistence-unit>
</persistence>
