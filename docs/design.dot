digraph AutoCareDesign {
    graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.8", fontname="Helvetica", label="AutoCare - aktualni aplikacijski odnosi", labelloc=t];
    node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#176B87", margin="0.18"];
    edge [fontname="Helvetica", fontsize=10, color="#526477"];

    controller [label="Controllers\nMainController\nServicesController\nProblemsController"];
    services [label="Services\nAuthService\nVehicleService\nServiceRecordService\nMaintenanceService\nProblemService"];
    repos [label="Repository interfaces\nUser / Vehicle / ServiceRecord\nProblem / Catalog"];
    jpaRepos [label="Jpa*Repository\nimplements interfaces\nJPQL and EntityManager"];
    strategy [label="<<interface>>\nDiagnosticStrategy"];
    keyword [label="KeywordDiagnosticStrategy\nnormalization + scoring"];
    result [label="Data.Analysis / DiagnosticResult\nplain temporary result"];
    domain [label="Domain\nServiceRecord\nProblem / Vehicle"];

    controller -> services [label="calls use-cases"];
    controller -> result [label="reads rows and preview"];
    services -> repos [label="uses contracts"];
    services -> domain [label="business methods"];
    services -> strategy [label="ProblemService policy"];
    services -> result [label="creates snapshots"];
    repos -> jpaRepos [style=dashed, label="implemented by"];
    jpaRepos -> domain [label="maps managed entities"];
    keyword -> strategy [style=dashed, label="implements"];
    strategy -> result [label="returns"];
}
