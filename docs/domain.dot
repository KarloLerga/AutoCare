digraph AutoCareDomain {
    graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.7", fontname="Helvetica", label="AutoCare - aktualna persistentna domena", labelloc=t];
    node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#176B87", margin="0.18"];
    edge [fontname="Helvetica", fontsize=10, color="#526477"];

    AppUser [label="AppUser\nid, name, email\npassword, activeVehicle\n+ activate(vehicle)"];
    VehicleVariant [label="VehicleVariant\nid, code, make, model\ngeneration, engineLabel\nyears, technical data\n+ covers(year)"];
    Vehicle [label="Vehicle\nid, productionYear\ncurrentMileage\n+ changeIdentity(...)\n+ updateMileage(km)"];
    WorkDefinition [label="WorkDefinition\nid, code, name, category\ndefault intervals and estimate"];
    VehicleWorkRule [label="VehicleWorkRule\nid, intervalKm, intervalMonths\nestimatedPrice, sources"];
    ServiceRecord [label="ServiceRecord\nid, serviceDate, mileage, note\n+ addItem(work, actualPrice)\n+ total()"];
    ServiceItem [label="ServiceItem\nid, actualPrice"];
    Problem [label="Problem\nid, description, status\ncreatedAt, analysis snapshot\n+ resolve(serviceRecord)"];
    DiagnosticRule [label="DiagnosticRule\nid, code, phrase\nweight, active"];
    WorkCategory [shape=ellipse, label="enum WorkCategory\nMAINTENANCE | REPAIR"];
    ProblemStatus [shape=ellipse, label="enum ProblemStatus\nOPEN | RESOLVED"];

    AppUser -> Vehicle [label="activeVehicle 0..1"];
    Vehicle -> AppUser [label="owner 1"];
    Vehicle -> VehicleVariant [label="variant 1"];
    VehicleWorkRule -> VehicleVariant [label="variant 1"];
    VehicleWorkRule -> WorkDefinition [label="work 1"];
    ServiceRecord -> Vehicle [label="vehicle 1"];
    ServiceRecord -> ServiceItem [dir=both, arrowtail=diamond, arrowhead=none, label="items 1..*"];
    ServiceItem -> WorkDefinition [label="work 1"];
    Problem -> Vehicle [label="vehicle 1"];
    Problem -> WorkDefinition [label="suggestedRepair 0..1"];
    Problem -> ServiceRecord [label="resolvedByService 0..1"];
    DiagnosticRule -> WorkDefinition [label="candidate 1"];
    WorkDefinition -> WorkCategory [style=dashed, label="value"];
    Problem -> ProblemStatus [style=dashed, label="value"];
}
