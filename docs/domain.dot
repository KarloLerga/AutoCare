digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.7", fontname="Helvetica"]; node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#176B87", margin="0.18"]; edge [fontname="Helvetica", fontsize=10, color="#526477"];
label="AutoCare AF-3 - domenski UML (sazeti prikaz)"; labelloc=t;
User [label="User\n------------------------\nid: Long\nversion: long\nname: String\nemail: String\npasswordHash: String\n------------------------\n+ activate(vehicle)"];
User -> Vehicle [label="activeVehicle / to-one"];
VehicleVariant [label="VehicleVariant\n------------------------\nid: Long\ncode: String\nmake: String\nmodel: String\ngeneration: String\nengineLabel: String\nbodyType: String"];
Vehicle [label="Vehicle\n------------------------\nid: Long\nversion: long\nyear: int\ncurrentMileage: int\n------------------------\n+ updateMileage(km)"];
Vehicle -> User [label="owner / to-one"];
Vehicle -> VehicleVariant [label="variant / to-one"];
WorkDefinition [label="WorkDefinition\n------------------------\nid: Long\ncode: String\nname: String\ncategory: WorkCategory\ndefaultEstimatedPrice: BigDecimal\nestimateNote: String"];
VehicleWorkRule [label="VehicleWorkRule\n------------------------\nid: Long\nscheduleKind: ScheduleKind\nintervalKm: Integer\nintervalMonths: Integer\nestimatedPrice: BigDecimal\nintervalSource: String\nestimateNote: String\n------------------------\n+ revise(...)"];
VehicleWorkRule -> VehicleVariant [label="variant / to-one"];
VehicleWorkRule -> WorkDefinition [label="work / to-one"];
ServiceRecord [label="ServiceRecord\n------------------------\nid: Long\nrequestKey: String\ndate: LocalDate\nmileage: int\nnote: String\n------------------------\n+ addItem(work, price)\n+ total(): CostSummary"];
ServiceRecord -> Vehicle [label="vehicle / to-one"];
ServiceItem [label="ServiceItem\n------------------------\nid: Long\nactualPrice: BigDecimal"];
ServiceItem -> WorkDefinition [label="work / to-one"];
Problem [label="Problem\n------------------------\nid: Long\nversion: long\nrequestKey: String\ndescription: String\nstatus: ProblemStatus\ncreatedAt: LocalDateTime\nmatchPercent: BigDecimal\n------------------------\n+ resolve(service)"];
Problem -> Vehicle [label="vehicle / to-one"];
Problem -> WorkDefinition [label="suggestedRepair / to-one"];
Problem -> ServiceRecord [label="resolvedByService / to-one"];
DiagnosticRule [label="DiagnosticRule\n------------------------\nid: Long\ncode: String\nphrase: String\nweight: int\nactive: boolean"];
DiagnosticRule -> WorkDefinition [label="candidate / to-one"];
ServiceRecord -> ServiceItem [dir=both,arrowtail=diamond,arrowhead=none,label="items 1..* / kompozicija"];
DiagnosticStrategy [label="<<interface>>
DiagnosticStrategy
+ analyze(description, rules)"];
