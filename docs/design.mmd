classDiagram
    MainController --> AuthService
    ServicesController --> ServiceRecordService
    ProblemsController --> ProblemService
    ServiceRecordService --> ServiceRecord
    ProblemService --> DiagnosticStrategy
    ProblemService --> Analysis
    DiagnosticStrategy <|.. KeywordDiagnosticStrategy
    ServiceRecordService --> ServiceRecordRepository
    ProblemService --> ProblemRepository
    ServiceRecordRepository <|.. JpaServiceRecordRepository
    ProblemRepository <|.. JpaProblemRepository

    class DiagnosticStrategy {
        <<interface>>
        analyze(description, rules)
    }
    class KeywordDiagnosticStrategy {
        normalize(text)
        analyze(description, rules)
    }
    class Analysis {
        description
        List DiagnosticResult results
    }
    class ServiceRecordService {
        create(ownerId, vehicleId, input)
        list(ownerId, vehicleId)
        detail(ownerId, serviceId)
    }
    class ProblemService {
        analyze(ownerId, vehicleId, description)
        save(ownerId, vehicleId, preview)
    }
