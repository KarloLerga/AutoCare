digraph AutoCareErD {
    graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.7", fontname="Helvetica", label="AutoCare - aktualni Azure SQL ERD (dbo; snake_case)", labelloc=t];
    node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#176B87", margin="0.18"];
    edge [fontname="Helvetica", fontsize=10, color="#526477"];

    app_user [label="dbo.app_user\nPK id BIGINT IDENTITY\nname NVARCHAR\nUQ email\npassword NVARCHAR\nFK active_vehicle_id BIGINT NULL"];
    vehicle_variant [label="dbo.vehicle_variant\nPK id BIGINT IDENTITY\nUQ code\nmake, model, generation\nengine_label, body_type, fuel_type\npower_hp, transmission\nyear_from, year_to"];
    vehicle [label="dbo.vehicle\nPK id BIGINT IDENTITY\nFK owner_id BIGINT\nFK variant_id BIGINT\nproduction_year INT\ncurrent_mileage INT"];
    work_definition [label="dbo.work_definition\nPK id BIGINT IDENTITY\nUQ code\nname, category\ndefault_interval_km/months\ndefault_estimated_price\nestimate_note"];
    vehicle_work_rule [label="dbo.vehicle_work_rule\nPK id BIGINT IDENTITY\nFK variant_id, work_id\ninterval_km/months\nestimated_price\ninterval_source, estimate_note"];
    service_record [label="dbo.service_record\nPK id BIGINT IDENTITY\nFK vehicle_id\nservice_date DATE\nmileage INT\nnote NVARCHAR NULL"];
    service_item [label="dbo.service_item\nPK id BIGINT IDENTITY\nFK service_record_id\nFK work_id\nactual_price DECIMAL(9,2) NULL"];
    problem [label="dbo.problem\nPK id BIGINT IDENTITY\nFK vehicle_id\ndescription, status\ncreated_at DATETIME2\noptional repair/resolve FKs\nmatch_percent, estimated_cost\nestimate_note"];
    diagnostic_rule [label="dbo.diagnostic_rule\nPK id BIGINT IDENTITY\nUQ code\nFK candidate_id\nphrase, weight, active"];

    app_user -> vehicle [label="active_vehicle_id"];
    vehicle -> app_user [label="owner_id"];
    vehicle -> vehicle_variant [label="variant_id"];
    vehicle_work_rule -> vehicle_variant [label="variant_id"];
    vehicle_work_rule -> work_definition [label="work_id"];
    service_record -> vehicle [label="vehicle_id"];
    service_item -> service_record [label="service_record_id"];
    service_item -> work_definition [label="work_id"];
    problem -> vehicle [label="vehicle_id"];
    problem -> work_definition [label="suggested_repair_id"];
    problem -> service_record [label="resolved_by_service_id"];
    diagnostic_rule -> work_definition [label="candidate_id"];
}
