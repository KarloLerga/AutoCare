digraph AutoCareErD {
    graph [
        rankdir=TB,
        bgcolor="white",
        pad="0.3",
        nodesep="0.5",
        ranksep="0.7",
        fontname="Helvetica",
        label="AutoCare - target SQL Server ERD (dbo; validate on Azure SQL)",
        labelloc=t
    ];
    node [
        fontname="Helvetica",
        shape=box,
        style="rounded,filled",
        fillcolor="#F4F7FB",
        color="#176B87",
        margin="0.18"
    ];
    edge [fontname="Helvetica", fontsize=10, color="#526477"];

    AppUser [label="dbo.AppUser\nPK id : BIGINT IDENTITY\nversion : BIGINT\nname : NVARCHAR(100)\nUQ email : NVARCHAR(254)\npasswordHash : NVARCHAR(255)\nFK activeVehicle_id : BIGINT ?"];
    VehicleVariant [label="dbo.VehicleVariant\nPK id : BIGINT IDENTITY\nUQ code : NVARCHAR(80)\nmake : NVARCHAR(100)\nmodel : NVARCHAR(150)\ngeneration : NVARCHAR(200)\nengineLabel : NVARCHAR(240)\nbodyType : NVARCHAR(100) ?\nfuelType : NVARCHAR(80) ?\npowerHp : INT ?\ntransmission : NVARCHAR(120) ?\nyearFrom : INT\nyearTo : INT ?\nimagePath : NVARCHAR(255) ?"];
    Vehicle [label="dbo.Vehicle\nPK id : BIGINT IDENTITY\nversion : BIGINT\nFK owner_id : BIGINT\nFK variant_id : BIGINT\nproductionYear : INT\ncurrentMileage : INT"];
    WorkDefinition [label="dbo.WorkDefinition\nPK id : BIGINT IDENTITY\nUQ code : NVARCHAR(80)\nname : NVARCHAR(160)\ncategory : NVARCHAR(20)\ndefaultEstimatedPrice : DECIMAL(9,2) ?\nestimateNote : NVARCHAR(1000) ?"];
    VehicleWorkRule [label="dbo.VehicleWorkRule\nPK id : BIGINT IDENTITY\nFK variant_id : BIGINT\nFK work_id : BIGINT\nintervalKm : INT ?\nscheduleKind : NVARCHAR(24)\nintervalMonths : INT ?\nestimatedPrice : DECIMAL(9,2) ?\nintervalSource : NVARCHAR(1000) ?\nestimateNote : NVARCHAR(1000) ?"];
    ServiceRecord [label="dbo.ServiceRecord\nPK id : BIGINT IDENTITY\nFK vehicle_id : BIGINT\nUQ requestKey : NVARCHAR(36)\nserviceDate : DATE\nmileage : INT\nnote : NVARCHAR(2000) ?"];
    ServiceItem [label="dbo.ServiceItem\nPK id : BIGINT IDENTITY\nFK serviceRecord_id : BIGINT\nFK work_id : BIGINT\nactualPrice : DECIMAL(9,2) ?"];
    Problem [label="dbo.Problem\nPK id : BIGINT IDENTITY\nversion : BIGINT\nFK vehicle_id : BIGINT\nUQ requestKey : NVARCHAR(36)\ndescription : NVARCHAR(2000)\nstatus : NVARCHAR(20)\ncreatedAt : DATETIME2\nFK suggestedRepair_id : BIGINT ?\nmatchPercent : DECIMAL(5,2) ?\nestimatedCost : DECIMAL(9,2) ?\nestimateNote : NVARCHAR(1000) ?\nFK resolvedByService_id : BIGINT ?"];
    DiagnosticRule [label="dbo.DiagnosticRule\nPK id : BIGINT IDENTITY\nUQ code : NVARCHAR(80)\nFK candidate_id : BIGINT\nphrase : NVARCHAR(160)\nweight : INT\nactive : BIT"];

    AppUser -> Vehicle [label="activeVehicle", arrowsize=0.7];
    Vehicle -> AppUser [label="owner", arrowsize=0.7];
    Vehicle -> VehicleVariant [label="variant", arrowsize=0.7];
    VehicleWorkRule -> VehicleVariant [label="variant", arrowsize=0.7];
    VehicleWorkRule -> WorkDefinition [label="work", arrowsize=0.7];
    ServiceRecord -> Vehicle [label="vehicle", arrowsize=0.7];
    ServiceItem -> ServiceRecord [label="serviceRecord", arrowsize=0.7];
    ServiceItem -> WorkDefinition [label="work", arrowsize=0.7];
    Problem -> Vehicle [label="vehicle", arrowsize=0.7];
    Problem -> WorkDefinition [label="suggestedRepair", arrowsize=0.7];
    Problem -> ServiceRecord [label="resolvedByService", arrowsize=0.7];
    DiagnosticRule -> WorkDefinition [label="candidate", arrowsize=0.7];
}
