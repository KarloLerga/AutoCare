erDiagram
    AppUser ||--o{ Vehicle : owns
    AppUser }o--o| Vehicle : activeVehicle
    VehicleVariant ||--o{ Vehicle : identifies
    Vehicle ||--o{ ServiceRecord : history
    ServiceRecord ||--|{ ServiceItem : contains
    WorkDefinition ||--o{ ServiceItem : describes
    VehicleVariant ||--o{ VehicleWorkRule : covers
    WorkDefinition ||--o{ VehicleWorkRule : applies
    Vehicle ||--o{ Problem : reports
    ServiceRecord o|--o{ Problem : resolves
    WorkDefinition o|--o{ Problem : suggestedRepair
    WorkDefinition ||--o{ DiagnosticRule : candidate
    AppUser {
        bigint id PK
        bigint version
        string name
        string email UK
        string passwordHash
        bigint activeVehicle_id FK
    }
    VehicleVariant {
        bigint id PK
        string code UK
        string make
        string model
        string generation
        string engineLabel
        string bodyType
        string fuelType
        int powerHp
        string transmission
        int yearFrom
        int yearTo
        string imagePath
    }
    Vehicle {
        bigint id PK
        bigint version
        bigint owner_id FK
        bigint variant_id FK
        int productionYear
        int currentMileage
    }
    WorkDefinition {
        bigint id PK
        string code UK
        string name
        string category
        decimal defaultEstimatedPrice
        string estimateNote
    }
    VehicleWorkRule {
        bigint id PK
        bigint variant_id FK
        bigint work_id FK
        string scheduleKind
        int intervalKm
        int intervalMonths
        decimal estimatedPrice
        string intervalSource
        string estimateNote
    }
    ServiceRecord {
        bigint id PK
        bigint vehicle_id FK
        string requestKey UK
        date serviceDate
        int mileage
        string note
    }
    ServiceItem {
        bigint id PK
        bigint serviceRecord_id FK
        bigint work_id FK
        decimal actualPrice
    }
    Problem {
        bigint id PK
        bigint version
        bigint vehicle_id FK
        string requestKey UK
        string description
        string status
        datetime createdAt
        bigint suggestedRepair_id FK
        decimal matchPercent
        decimal estimatedCost
        string estimateNote
        bigint resolvedByService_id FK
    }
    DiagnosticRule {
        bigint id PK
        string code UK
        bigint candidate_id FK
        string phrase
        int weight
        boolean active
    }
