digraph AutoCareArchitecture {
    graph [
        rankdir=TB,
        bgcolor="white",
        pad="0.3",
        nodesep="0.5",
        ranksep="0.7",
        fontname="Helvetica",
        label="AutoCare - architecture dependencies (not data flow)",
        labelloc=t
    ];
    node [
        fontname="Helvetica",
        shape=box,
        style="rounded,filled",
        fillcolor="#F4F7FB",
        color="#176B87",
        margin="0.18"
    ];
    edge [fontname="Helvetica", fontsize=10, color="#526477"];

    view [label="VIEW\nSwing panels, forms and drafts\nFlatLaf only styles the UI"];
    controller [label="CONTROLLER\nActionListener + SwingWorker\nEDT UI / background I/O"];
    service [label="SERVICE\nUse-case, validation\nBUSINESS transaction boundary"];
    domain [label="DOMAIN\n9 persistent entities\nenums and calculators"];
    repositories [label="REPOSITORY INTERFACES\nUser / Vehicle / ServiceRecord\nProblem / Catalog"];
    transaction [label="TransactionRunner\ninterface boundary"];
    strategy [label="DiagnosticStrategy\ninterface"];
    jpaTransaction [label="JpaTransactionRunner\nTECHNICAL transaction lifecycle\none EntityManager per operation"];
    jpaRepositories [label="JPA REPOSITORIES\nJPQL / persist / remove\nshared EntityManager"];
    infrastructure [label="JPA / Hibernate / JDBC\nAzure SQL provider"];
    database [shape=cylinder, label="Azure SQL Database\ndbo target schema"];

    view -> controller [label="UI dependency"];
    controller -> service [label="use-case dependency"];
    service -> domain [label="business model"];
    service -> repositories [label="query/persist contract"];
    service -> transaction [label="transaction callback"];
    service -> strategy [label="diagnostic policy"];
    jpaTransaction -> transaction [style=dashed, label="implements"];
    jpaTransaction -> jpaRepositories [label="constructs with one EM"];
    jpaRepositories -> repositories [style=dashed, label="implements"];
    jpaRepositories -> domain [label="maps entities"];
    jpaTransaction -> infrastructure [label="lifecycle"];
    jpaRepositories -> infrastructure [label="JPA provider"];
    infrastructure -> database [label="technical resource"];
}
