digraph AutoCareArchitecture {
    graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.7", fontname="Helvetica", label="AutoCare - aktualne arhitekturne ovisnosti", labelloc=t];
    node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#176B87", margin="0.18"];
    edge [fontname="Helvetica", fontsize=10, color="#526477"];

    view [label="VIEW\nSwing forms, dialogs and tables\nFlatLaf styles UI"];
    controller [label="CONTROLLER\nActionListener\ncoordinates View and Service"];
    service [label="SERVICE\nuse-case and validation\nBUSINESS transaction boundary"];
    domain [label="DOMAIN\n9 persistent entities\nenums and calculators"];
    repositories [label="REPOSITORY INTERFACES\nUser / Vehicle / ServiceRecord\nProblem / Catalog"];
    jpaRepositories [label="JPA REPOSITORIES\nJPQL / persist / remove\nprovided EntityManager"];
    strategy [label="DiagnosticStrategy\nanalysis policy interface"];
    infrastructure [label="JPA / Hibernate / JDBC\nAzure SQL provider"];
    database [shape=cylinder, label="Azure SQL Database\ndbo snake_case schema"];

    view -> controller [label="UI dependency"];
    controller -> service [label="use-case call"];
    service -> domain [label="business model"];
    service -> repositories [label="query/persist contract"];
    service -> strategy [label="ProblemService policy"];
    jpaRepositories -> repositories [style=dashed, label="implements"];
    jpaRepositories -> domain [label="maps entities"];
    jpaRepositories -> infrastructure [label="JPA provider"];
    infrastructure -> database [label="technical resource"];
}
