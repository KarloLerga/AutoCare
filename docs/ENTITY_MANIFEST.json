{
  "status": "active-final-runtime",
  "schema": "dbo",
  "physicalNamingStrategy": "org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy",
  "hbm2ddl": "none",
  "entities": [
    {
      "java": "AppUser",
      "table": "app_user",
      "columns": ["id", "name", "email", "password_hash", "active_vehicle_id"]
    },
    {
      "java": "VehicleVariant",
      "table": "vehicle_variant",
      "columns": ["id", "code", "make", "model", "generation", "engine_label", "body_type", "fuel_type", "power_hp", "transmission", "year_from", "year_to", "image_path"]
    },
    {
      "java": "Vehicle",
      "table": "vehicle",
      "columns": ["id", "owner_id", "variant_id", "production_year", "current_mileage"]
    },
    {
      "java": "WorkDefinition",
      "table": "work_definition",
      "columns": ["id", "code", "name", "category", "default_interval_km", "default_interval_months", "default_estimated_price", "estimate_note"]
    },
    {
      "java": "VehicleWorkRule",
      "table": "vehicle_work_rule",
      "columns": ["id", "variant_id", "work_id", "interval_km", "interval_months", "estimated_price", "interval_source", "estimate_note"]
    },
    {
      "java": "ServiceRecord",
      "table": "service_record",
      "columns": ["id", "vehicle_id", "service_date", "mileage", "note"]
    },
    {
      "java": "ServiceItem",
      "table": "service_item",
      "columns": ["id", "service_record_id", "work_id", "actual_price"]
    },
    {
      "java": "Problem",
      "table": "problem",
      "columns": ["id", "vehicle_id", "description", "status", "created_at", "suggested_repair_id", "match_percent", "estimated_cost", "estimate_note", "resolved_by_service_id"]
    },
    {
      "java": "DiagnosticRule",
      "table": "diagnostic_rule",
      "columns": ["id", "code", "candidate_id", "phrase", "weight", "active"]
    }
  ],
  "legacyColumnsRemovedByFinalCleanup": [
    "app_user.version",
    "vehicle.version",
    "problem.version",
    "problem.request_key",
    "service_record.request_key",
    "vehicle_work_rule.schedule_kind"
  ]
}
